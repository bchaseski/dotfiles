# GUI Apps (casks)
cask "visual-studio-code"
cask "warp"               # modern terminal
cask "google-chrome"
cask "tableplus"          # DB GUI (fast, native macOS)
cask "dbeaver-community"  # DB GUI (free, supports everything)
cask "insomnia"           # API client
cask "postman"            # API client (primary)
cask "rectangle"          # window snapping
cask "raycast"            # Spotlight replacement (much more powerful)
cask "alt-tab"            # Windows-style Alt+Tab with window previews
cask "karabiner-elements" # key remapping (remap Caps Lock, etc.)
cask "claude"             # Claude Desktop
cask "orbstack"           # Docker Desktop replacement (containers + VMs)
cask "github"             # GitHub Desktop
cask "mongodb-compass"    # MongoDB GUI
cask "snagit"             # screen capture
cask "logi-options+"      # Logitech peripherals
cask "caffeine"           # prevent sleep

