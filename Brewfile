# Core CLI
brew "git"
brew "gh"             # GitHub CLI
brew "curl"
brew "wget"
brew "jq"             # JSON in the terminal
brew "tree"
brew "htop"
brew "stow"           # manages symlinks for us

# GNU userland (familiar from Linux/WSL)
brew "coreutils"      # GNU ls, cp, mv, etc.
brew "gnu-sed"        # GNU sed (macOS sed behaves differently)
brew "grep"           # GNU grep
brew "bash"           # newer bash (macOS ships 3.2)

# zsh enhancements
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "starship"       # cross-shell prompt

# Node / JS
brew "fnm"            # Node version manager

# Python
brew "python"
brew "pipx"           # install Python CLI tools cleanly
brew "pyenv"          # Python version manager

